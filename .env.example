# ─── Cloudflare R2 ───────────────────────────────────────────
# Server-side only. Never exposed to the browser: the studio talks to /api/*,
# which signs one-time upload URLs.
#
# Where to find each value (Cloudflare dashboard → R2):
#   R2_ACCOUNT_ID          R2 overview page, or the first part of the S3 API
#                          endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   R2_BUCKET              the bucket name, e.g. asani-portfolio
#   R2_ACCESS_KEY_ID       R2 → API → Manage API Tokens → Create (Object Read & Write)
#   R2_SECRET_ACCESS_KEY   shown once when the token is created — copy it then
#   R2_PUBLIC_HOST         the custom domain on the bucket, e.g. videos.sydhustle.com
#                          (do NOT use the rate-limited *.r2.dev URL in production)

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_HOST=

# Same hostname as R2_PUBLIC_HOST. This one IS sent to the browser, which is
# fine — it appears in every video URL anyway. The portfolio reads
# https://$VITE_R2_PUBLIC_HOST/manifest.json directly from the CDN.
VITE_R2_PUBLIC_HOST=

# ─── Studio ──────────────────────────────────────────────────
# Gate for /studio (upload + delete). Pick something long and random.
# If unset, the studio stays locked and no uploads are possible.
STUDIO_PASSWORD=
